#!/usr/bin/env bash
# selene-db pre-push gate — FAST lint/build guard only.
#
# The full nextest + doctest suite intentionally does NOT run here: workspace
# nextest runs on every non-draft development PR, and release.yml adds doctests
# plus the complete development -> main release gate. Keeping pre-push to fast
# clippy avoids repeating the workspace suite locally.
# Skip once:    git push --no-verify
# Skip session: export SELENE_SKIP_HOOKS=1
set -euo pipefail
[ -n "${SELENE_SKIP_HOOKS:-}" ] && { echo "[pre-push] skipped (SELENE_SKIP_HOOKS)"; exit 0; }
cd "$(git rev-parse --show-toplevel)"

echo "[pre-push] cargo clippy --workspace -- -D warnings  (workspace nextest runs in development CI)"
cargo clippy --workspace --locked -- -D warnings

echo "[pre-push] ok"
