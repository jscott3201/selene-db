{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jscott3201/selene-db/blob/development/docs/v2/roadmap/plan.schema.json",
  "title": "Selene DB 2.0 portable implementation plan",
  "type": "object",
  "required": [
    "meta",
    "status_values",
    "milestones",
    "pull_requests",
    "issues",
    "decisions"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "repository",
        "source_branch",
        "reviewed_source_sha",
        "installation_base_sha",
        "review_date",
        "target_version",
        "archive_branch",
        "archive_tag",
        "archive_state",
        "milestone_count",
        "pr_count",
        "issue_count",
        "decision_count",
        "plan_version",
        "line_in_sand",
        "machine_role"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "const": "jscott3201/selene-db"
        },
        "source_branch": {
          "const": "development"
        },
        "reviewed_source_sha": {
          "const": "b8782bec34ff0b815b62711ac7e33cac09d8ea71"
        },
        "installation_base_sha": {
          "const": "c5c0a9855f5c043ecc927d561e4ad8ba001346d9"
        },
        "review_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "target_version": {
          "const": "2.0.0-alpha.1"
        },
        "archive_branch": {
          "const": "archive/1.x-final"
        },
        "archive_tag": {
          "const": "archive-v1-eol-2026-08-21"
        },
        "archive_state": {
          "const": "pending_owner_only"
        },
        "milestone_count": {
          "const": 11
        },
        "pr_count": {
          "const": 65
        },
        "issue_count": {
          "const": 7
        },
        "decision_count": {
          "const": 22
        },
        "plan_version": {
          "const": 2
        },
        "line_in_sand": {
          "type": "string",
          "minLength": 1
        },
        "machine_role": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "status_values": {
      "type": "array",
      "items": {
        "enum": [
          "Unmerged",
          "Merged"
        ]
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "milestones": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "$ref": "#/$defs/milestone"
      }
    },
    "pull_requests": {
      "type": "array",
      "minItems": 65,
      "maxItems": 65,
      "items": {
        "$ref": "#/$defs/pull_request"
      }
    },
    "issues": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "milestone": {
      "type": "object",
      "required": [
        "id",
        "title",
        "objective",
        "rationale",
        "dependencies",
        "entry",
        "decisions",
        "exit",
        "risks",
        "iso_anchors",
        "number",
        "file",
        "pr_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M(?:0[0-9]|10)$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entry": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exit": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "iso_anchors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "number": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "file": {
          "type": "string",
          "pattern": "^docs/v2/[^#]+#[A-Za-z0-9._-]+$"
        },
        "pr_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^M(?:0[0-9]|10)-PR[0-9]{2}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "delivery_part": {
      "type": "object",
      "required": [
        "number",
        "title",
        "outcome",
        "production_paths",
        "max_production_files",
        "max_net_non_generated_lines",
        "work_item_status_after",
        "issue_state_after",
        "dependents_unblocked_after",
        "bridge_state_after",
        "acceptance",
        "bridge_deletion_state",
        "completion_effect"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "production_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
          },
          "minItems": 1,
          "maxItems": 25,
          "uniqueItems": true
        },
        "max_production_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "max_net_non_generated_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1500
        },
        "work_item_status_after": {
          "enum": [
            "Unmerged",
            "Merged"
          ]
        },
        "issue_state_after": {
          "enum": [
            "Open",
            "Closed"
          ]
        },
        "dependents_unblocked_after": {
          "type": "boolean"
        },
        "bridge_state_after": {
          "enum": [
            "Retained",
            "Deleted"
          ]
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "bridge_deletion_state": {
          "type": "string",
          "minLength": 1
        },
        "completion_effect": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "pull_request": {
      "type": "object",
      "required": [
        "id",
        "milestone",
        "number",
        "title",
        "outcome",
        "dependencies",
        "issues",
        "iso_anchors",
        "risk",
        "size",
        "crates",
        "expected_paths",
        "scope",
        "non_goals",
        "design",
        "acceptance",
        "tests",
        "benchmarks",
        "docs",
        "review_focus",
        "stop_conditions",
        "bridge",
        "commit_scope",
        "status",
        "file"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M(?:0[0-9]|10)-PR[0-9]{2}$"
        },
        "milestone": {
          "type": "string",
          "pattern": "^M(?:0[0-9]|10)$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^M(?:0[0-9]|10)-PR[0-9]{2}$"
          },
          "uniqueItems": true
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "iso_anchors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk": {
          "enum": [
            "Low",
            "Medium",
            "High",
            "Critical"
          ]
        },
        "size": {
          "enum": [
            "S",
            "M",
            "L"
          ]
        },
        "crates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "delivery_parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delivery_part"
          },
          "minItems": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "design": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "benchmarks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "review_focus": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "bridge": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "commit_scope": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "Unmerged",
            "Merged"
          ]
        },
        "file": {
          "type": "string",
          "pattern": "^docs/v2/[^#]+#[A-Za-z0-9._-]+$"
        }
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "required": [
        "number",
        "title",
        "owner",
        "url",
        "file"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "pattern": "^M(?:0[0-9]|10)-PR[0-9]{2}$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://github.com/jscott3201/selene-db/issues/[0-9]+$"
        },
        "file": {
          "type": "string",
          "pattern": "^docs/v2/[^#]+#[A-Za-z0-9._-]+$"
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "id",
        "area",
        "decision",
        "file"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^D-[0-9]{3}$"
        },
        "area": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^docs/v2/[^#]+#[A-Za-z0-9._-]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
